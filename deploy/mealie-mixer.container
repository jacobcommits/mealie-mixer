# Podman Quadlet unit — auto-start Mealie Mixer on boot (rootless).
#
# Docker users don't need this: `restart: unless-stopped` + an enabled Docker
# service already restarts the container after a reboot.
#
# Podman setup (rootless):
#   1. Build the image:   podman build --format docker -t mealie-mixer /path/to/repo
#   2. Install this unit:  cp mealie-mixer.container ~/.config/containers/systemd/
#   3. Allow user services at boot:  loginctl enable-linger "$USER"
#   4. Load + start:       systemctl --user daemon-reload && systemctl --user start mealie-mixer
#   It will then start automatically on every boot.

[Unit]
Description=Mealie Mixer
After=network-online.target

[Container]
Image=localhost/mealie-mixer:latest
ContainerName=mealie-mixer
PublishPort=7860:7860
Volume=mealie-mixer-data:/data
# Optional: load config from a .env instead of the in-app setup page:
# EnvironmentFile=%h/mealie-mixer/.env

[Service]
Restart=unless-stopped

[Install]
WantedBy=default.target
