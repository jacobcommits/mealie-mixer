# Mealie Mixer — copy to `.env` and fill in your own values.
#   cp .env.example .env

# ── AI backend (extraction) ──────────────────────────────────────────
# Backend is swappable: point these at OpenRouter / OpenAI / a local model.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.1-flash-lite
AI_API_KEY=your-google-ai-studio-key

# ── Mealie (push) ────────────────────────────────────────────────────
MEALIE_URL=http://your-mealie-host:9925
# Long-lived token from Mealie -> /user/profile/api-tokens
MEALIE_TOKEN=your-mealie-api-token

# ── UI login (optional) ──────────────────────────────────────────────
# Set BOTH to require a username/password on the web UI. Leave blank for none.
MIXER_AUTH_USER=
MIXER_AUTH_PASS=
